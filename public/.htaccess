# Policy Translator: static single-page app on Hostinger (Apache / LiteSpeed)
Options -MultiViews
RewriteEngine On

# Send http to https (the X-Forwarded-Proto check avoids a loop behind a proxy)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve real files and folders as they are
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes to index.html (for routes added later)
RewriteRule ^ index.html [L]

# Hashed build assets can be cached for a long time; index.html never
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
